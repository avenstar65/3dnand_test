#!/bin/sh
set -eu

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mount -t tmpfs none /dev
mkdir -p /dev/pts /tmp /run /mnt /lib/modules
mount -t devpts none /dev/pts 2>/dev/null || true
mkdir -p /sys/kernel/debug
mount -t debugfs none /sys/kernel/debug 2>/dev/null || true

echo
echo "Linux MTD QEMU 开发环境已启动"
echo "可运行: /etc/profile.d/mtd.sh smoke"
echo

if [ -r /etc/profile.d/mtd.sh ]; then
  . /etc/profile.d/mtd.sh
fi

case "${MTD_SMOKE:-0}" in
  q3n-kunit-smoke) mtd_test=mtd_q3n_kunit_smoke ;;
  q3n-raid1-smoke) mtd_test=mtd_q3n_raid1_smoke ;;
  q3n-raid5-smoke) mtd_test=mtd_q3n_raid5_smoke ;;
  q3n-serial-smoke) mtd_test=mtd_q3n_serial_smoke ;;
  q3n-persist-prepare) mtd_test=mtd_q3n_persist_prepare ;;
  q3n-persist-verify) mtd_test=mtd_q3n_persist_verify ;;
  ubifs) mtd_test=mtd_ubifs ;;
  1) mtd_test=mtd_smoke ;;
  *) mtd_test= ;;
esac

if [ -n "$mtd_test" ]; then
  if $mtd_test; then
    echo "MTD smoke 测试通过，关闭虚拟机"
    poweroff -f
  fi

  echo "MTD smoke 测试失败，进入 shell"
  case "${MTD_SMOKE:-0}" in
    q3n-kunit-smoke|q3n-raid1-smoke|q3n-raid5-smoke|q3n-serial-smoke|q3n-persist-*) poweroff -f ;;
  esac
fi

exec /bin/sh
