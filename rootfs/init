#!/bin/sh
set -eu

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || mount -t tmpfs none /dev
mkdir -p /dev/pts /tmp /run /mnt /lib/modules
mount -t devpts none /dev/pts 2>/dev/null || true

echo
echo "Linux MTD QEMU 开发环境已启动"
echo "可运行: /etc/profile.d/mtd.sh smoke"
echo

if [ -r /etc/profile.d/mtd.sh ]; then
  . /etc/profile.d/mtd.sh
fi

if [ "${MTD_SMOKE:-0}" = "1" ]; then
  mtd_smoke || echo "MTD smoke 测试失败，进入 shell"
fi

exec /bin/sh

