From d4499a237493041fcc859b46ff7181b8c81a3fc6 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 28 Jul 2026 23:13:10 +0800
Subject: [PATCH 1/3] mtd: rawnand: add exact geometry helpers

---
 drivers/mtd/nand/raw/internals.h | 78 ++++++++++++++++++++++++++++++++
 include/linux/mtd/rawnand.h      |  6 +++
 2 files changed, 84 insertions(+)

diff --git a/drivers/mtd/nand/raw/internals.h b/drivers/mtd/nand/raw/internals.h
index b7162ce..24064c1 100644
--- a/drivers/mtd/nand/raw/internals.h
+++ b/drivers/mtd/nand/raw/internals.h
@@ -76,6 +76,84 @@ extern const struct nand_manufacturer_ops samsung_nand_manuf_ops;
 extern const struct nand_manufacturer_ops sandisk_nand_manuf_ops;
 extern const struct nand_manufacturer_ops toshiba_nand_manuf_ops;
 
+static inline bool nand_has_non_power_of_2_geometry(struct nand_chip *chip)
+{
+	return chip->options & NAND_NON_POWER_OF_2_GEOMETRY;
+}
+
+static inline u64 nand_page_to_offs(struct nand_chip *chip, u64 page)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return page * nand_to_mtd(chip)->writesize;
+
+	return page << chip->page_shift;
+}
+
+static inline u64 nand_offs_to_page(struct nand_chip *chip, loff_t offs)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return offs / nand_to_mtd(chip)->writesize;
+
+	return offs >> chip->page_shift;
+}
+
+static inline u64 nand_offs_to_eraseblock(struct nand_chip *chip, loff_t offs)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return offs / nand_to_mtd(chip)->erasesize;
+
+	return offs >> chip->phys_erase_shift;
+}
+
+static inline u32 nand_offs_in_eraseblock(struct nand_chip *chip, loff_t offs)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return offs % nand_to_mtd(chip)->erasesize;
+
+	return offs & (nand_to_mtd(chip)->erasesize - 1);
+}
+
+static inline u32 nand_offs_to_target(struct nand_chip *chip, loff_t offs)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return offs / nanddev_target_size(&chip->base);
+
+	return offs >> chip->chip_shift;
+}
+
+static inline u64 nand_page_in_target(struct nand_chip *chip, u64 page)
+{
+	if (nand_has_non_power_of_2_geometry(chip)) {
+		u64 pages_per_target = nanddev_target_size(&chip->base) /
+				       nand_to_mtd(chip)->writesize;
+
+		return page % pages_per_target;
+	}
+
+	return page & chip->pagemask;
+}
+
+static inline u32 nand_pages_per_eraseblock(struct nand_chip *chip)
+{
+	return nand_to_mtd(chip)->erasesize / nand_to_mtd(chip)->writesize;
+}
+
+static inline u64 nand_page_to_eraseblock(struct nand_chip *chip, u64 page)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return page / nand_pages_per_eraseblock(chip);
+
+	return page >> (chip->phys_erase_shift - chip->page_shift);
+}
+
+static inline u64 nand_eraseblock_to_page(struct nand_chip *chip, u64 block)
+{
+	if (nand_has_non_power_of_2_geometry(chip))
+		return block * nand_pages_per_eraseblock(chip);
+
+	return block << (chip->phys_erase_shift - chip->page_shift);
+}
+
 /* MLC pairing schemes */
 extern const struct mtd_pairing_scheme dist3_pairing_scheme;
 
diff --git a/include/linux/mtd/rawnand.h b/include/linux/mtd/rawnand.h
index 5c70e7b..82dfd03 100644
--- a/include/linux/mtd/rawnand.h
+++ b/include/linux/mtd/rawnand.h
@@ -150,6 +150,12 @@ struct gpio_desc;
 /* Device needs 3rd row address cycle */
 #define NAND_ROW_ADDR_3		BIT(14)
 
+/*
+ * Page and eraseblock sizes are not powers of two. Raw NAND core code must
+ * use exact multiplication, division and remainder instead of shifts/masks.
+ */
+#define NAND_NON_POWER_OF_2_GEOMETRY	BIT(15)
+
 /* Non chip related options */
 /* This option skips the bbt scan during initialization. */
 #define NAND_SKIP_BBTSCAN	BIT(16)
